{
    "encoderVer": "7.00", // 1.00, 1.01, 2.00, 3.01, 4.01, 5.00, 6.00, 7.00
    "options": {
        // The lodType is metadata from Roblox describing what technique was used to auto-generate LODs for this mesh.
        // but otherwise is unimportant
        "lodType": "ZeuxMeshOptimizer", // None | Unknown | RbxSimplifier | ZeuxMeshOptimizer
        "autoLODs": {
            "method": "ZeuxMeshOptimizer", // QEM | MC | ZeuxMeshOptimizer
            "levels": 4, // honestly, what the fuck is wrong with roblox engine?, LODs from 5 to 9 doesn't even show up even when you try and force them to
            "resolution": 0.8, // for model faces
            // Calculation: resolution ^ cur_level
            // NEVER EVER SET "resolution" TO SOMETHING LOWER THAN 0.5 IF YOU'RE USING LOW POLY MODEL
            // USE EITHER 0.8 OR 0.7

            // you don't want your model be be one stick... let it be two sticks!
            "minFaces": 4,

            // for thee nerd that want to have their own resolutions (non level dependent)
            "ratiosEnabled": true,
            "ratios": [
                0.9,    //LV1
                0.8,    //LV2
                0.7,    //LV3
                0.6,    //LV4
                0.5,    //LV5
                0.4,    //LV6
                0.3,    //LV7
                0.2,    //LV8
                0.1     //LV9
            ],

            "methodOptions": {
                "ZeuxMeshOptimizer": {
	                // Weld corners by position + normal + uv (true, default) so UV seams and
	                // hard edges stay intact, or by position only (false: smoother LODs but
	                // seams/normals are taken from the first corner at each position).
                    // Default false.
	                "weldAttributes": false,

                    // true: collapsed vertices are moved to better positions and their
                    // UVs/normals are re-solved to match (best UV quality, returns modified
                    // copies). false: vertex data stays exactly as given and only the
                    // triangle list shrinks.
                    // Default true.
                    "updateVertices": true,

                    // Keep vertices on open mesh boundaries in place.
                    // Default true.
                    "lockBorder": true,

                    // More regular triangle sizes/shapes, at some cost to fidelity.
                    // Default false.
                    "regularize": false,

                    // Remove small disconnected parts while simplifying.
                    // Default false.
                    "prune": false,

                    // Allow collapses across attribute seams (needed if the mesh is so
                    // faceted/seamy that simplification gets stuck).
                    // Default false.
                    "permissive": false,

                    // Importance of UV preservation vs position. Higher = less UV
                    // stretching/"melting", at the cost of position accuracy.
                    // 0 ignores UVs entirely.
                    // Default 2.
                    "uvWeight": 2,

                    // Same for vertex normals (shading). 
                    // 0 ignores normals.
                    // Default 1.
                    "normalWeight": 1,

                    // Error tolerance relative to mesh extents, e.g. 0.01 = 1% deformation.
                    // Default 1. (effectively no limit: targetIndexCount decides).
                    "targetError": 1
                },
                // NULL [no options]
                "QEM": {},
                // NULL [no options]
                "MC": {}
            }
        }
    }
}